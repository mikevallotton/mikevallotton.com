{
  "name": "mikevallotton-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "validate:content": "node scripts/verify-news-investigator-prompt.mjs && node scripts/validate-content.mjs && node scripts/verify-latest-content.mjs",
    "lint": "npm run validate:content && eslint . --max-warnings=0",
    "check": "npm run lint && npm run build",
    "smoke": "node scripts/smoke-release.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "10.5.4",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3"
  }
}
